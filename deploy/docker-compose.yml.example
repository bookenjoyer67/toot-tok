# TootTok compose example — copy to docker-compose.yml and adjust.
# The live docker-compose.yml is gitignored (may hold local tweaks).
services:
  db:
    image: postgres:18-alpine
    environment:
      POSTGRES_USER: toottok
      POSTGRES_PASSWORD: change-me
      POSTGRES_DB: toottok_dev
    volumes:
      # postgres:18 image expects the mount at the parent; it places data in
      # /var/lib/postgresql/data itself (pg_upgrade-friendly layout).
      - pgdata:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U toottok"]
      interval: 5s
      timeout: 3s
      retries: 10

  app:
    image: toottok:local
    build:
      context: ..
      dockerfile: deploy/Dockerfile
    environment:
      DATABASE_URL: postgres://toottok:change-me@db:5432/toottok_dev
      TOOTTOK_BIND: 0.0.0.0:8080
      TOOTTOK_MEDIA_DIR: /data/media
      TOOTTOK_DOMAIN: toottok.example
    depends_on:
      db:
        condition: service_healthy
    ports:
      # Pick a host port free on your box (8080 may be taken by other apps).
      - "8088:8080"
    volumes:
      - media:/data/media
      # Optional: override the image's built frontend with a local build
      # while iterating on web changes. Resolves relative to THIS file's dir.
      # - ../web/build:/usr/local/share/toottok/web:ro

volumes:
  pgdata:
  media:
